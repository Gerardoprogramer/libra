# Names and empty placeholders only. Copy to .env.local and never commit real values.
#
# IMPORTANT: DATABASE_URL and DIRECT_DATABASE_URL in .env.local decide which database the scripts write to.
# Keep a separate development database for them. The scripts print the target (masked host, role, id) and
# need --confirm-database <id> to write to a remote one; `pnpm db:seed` refuses remote databases entirely.

# PostgreSQL URLs must support TLS. DATABASE_URL is used by the web application (pooled connection).
DATABASE_URL=

# Direct/session connection used by Drizzle migrations and the editorial scripts (imports, review, seeds).
# An import dry run reads it too: it compares the EPUB with this database.
DIRECT_DATABASE_URL=

# Supabase Auth (browser and server). Both values are public by design: the publishable key only identifies
# the project. Never put a service-role key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production canonical origin, e.g. SITE_URL=https://www.example.com (a reserved documentation domain: use your own).
# May be unset in development.
SITE_URL=

# Public HTTPS URL for rendering existing covers (custom domain or R2 public domain).
R2_PUBLIC_URL=

# Required when importing an EPUB with a cover using --apply.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional post-commit cache invalidation for editorial scripts.
# Next.js and the scripts must use the same private, randomly generated secret.
# Write the value WITHOUT quotes. It must be identical in Vercel (Production) and in your local environment; Vercel
# applies a changed variable only to new deployments, so redeploy Production after changing it.
# Leave empty to disable the endpoint; never use a NEXT_PUBLIC_ variable.
CACHE_REVALIDATION_SECRET=

# Scripts only: full URL of the Next.js endpoint (no secret in the URL).
# Point it at the DEPLOYED site when the database being changed is the one that site reads; a localhost URL
# leaves the production cache untouched until it expires.
# Use the exact canonical origin, including "www." when that is the canonical host: the client does not follow
# redirects, so a host that redirects is reported as a failed invalidation.
CACHE_REVALIDATION_URL=http://localhost:3000/api/revalidate-cache
