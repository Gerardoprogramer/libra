# Editorial imports: required only for --apply, never for collection dry-runs.
# PostgreSQL URLs must support TLS. DATABASE_URL is used by the web application.
DATABASE_URL=

# Direct connection used by editorial scripts that write to PostgreSQL.
DIRECT_DATABASE_URL=

# Canonical public site origin. When unset, absolute canonical and hreflang URLs are omitted.
SITE_URL=

# Public HTTPS URL for rendering existing covers (custom domain or R2 public domain).
R2_PUBLIC_URL=

# Required when importing an EPUB with a cover using --apply.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional post-commit cache invalidation for editorial scripts.
# Next.js and the scripts must use the same private, randomly generated secret.
# Leave empty to disable the endpoint; never use a NEXT_PUBLIC_ variable.
CACHE_REVALIDATION_SECRET=

# Scripts only: full URL of the Next.js endpoint (no secret in the URL).
# Use the deployment URL instead when the database changes affect production.
CACHE_REVALIDATION_URL=http://localhost:3000/api/revalidate-cache
